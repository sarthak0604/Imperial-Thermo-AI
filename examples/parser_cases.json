    {"id":"natural-01","category":"natural","question":"I'm trying to understand how flames spread in space. Which experiments looked at that?","expected":{"intent":"find","return_types":["Experiment"],"filters":[{"field":"name","value_any_of":["flame propagation","flame spread","flame spreading"]}]}},
