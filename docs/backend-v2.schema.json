          "type": "string"
        },
        "selected_file_ids": {
          "items": {
            "type": "string"
          },
          "title": "Selected File Ids",
          "type": "array"
        },
        "requested_asset_ids": {
          "items": {
            "type": "string"
          },
          "title": "Requested Asset Ids",
          "type": "array"
        },
        "operation": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlotOperation"
            },
            {
              "$ref": "#/$defs/ThermoOperation"
