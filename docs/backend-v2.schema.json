            {
              "type": "null"
            }
          ],
          "title": "Operation"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "action",
        "selected_file_ids",
        "requested_asset_ids",
        "operation",
        "explanation",
        "warnings"
      ],
      "title": "Plan",
      "type": "object"
    },
    "PlotOperation": {
      "additionalProperties": false,
