          "title": "Illustrative"
        },
        "source_file_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source File Ids",
          "type": "array"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        }
      },
