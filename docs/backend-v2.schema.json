      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "calculation",
            "chart",
            "inspection",
            "document",
            "video",
            "image",
            "explanation",
            "discovery"
