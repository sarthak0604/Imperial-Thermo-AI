    "Plan": {
      "additionalProperties": false,
      "description": "All fields required so this is also an API Structured Outputs schema.",
      "properties": {
        "action": {
          "enum": [
            "inspect_files",
            "calculate",
            "retrieve_assets",
            "no_match"
          ],
