        "investigations": {
          "items": {
            "type": "string"
          },
          "title": "Investigations",
          "type": "array"
        },
        "excluded_investigations": {
          "items": {
            "type": "string"
          },
          "title": "Excluded Investigations",
          "type": "array"
        },
        "clarifications": {
          "items": {
            "type": "string"
          },
          "title": "Clarifications",
          "type": "array"
