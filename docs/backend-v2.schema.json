      "type": "object"
    },
    "ColumnBinding": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "title": "Column",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "column",
        "field",
        "unit"
      ],
      "title": "ColumnBinding",
      "type": "object"
    },
    "DatasetBinding": {
      "additionalProperties": false,
      "description": "Copy measured CSV values into an existing JSON input slot, without conversion.",
      "properties": {
        "target": {
          "pattern": "^/",
          "title": "Target",
          "type": "string"
        },
        "mode": {
          "enum": [
            "scalar",
            "series",
            "records"
          ],
          "title": "Mode",
          "type": "string"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/ColumnBinding"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "row": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Row"
        }
      },
      "required": [
        "target",
        "mode",
        "columns",
        "row"
      ],
      "title": "DatasetBinding",
      "type": "object"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "file_id": {
          "title": "File Id",
          "type": "string"
        },
        "investigation_id": {
          "title": "Investigation Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "review_status": {
          "title": "Review Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "file_id",
        "investigation_id",
        "title",
        "text",
        "locator",
        "source_url",
        "sha256",
        "review_status"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "ExecutionLimits": {
      "additionalProperties": false,
      "properties": {
        "max_download_bytes": {
          "default": 100000000,
          "exclusiveMinimum": 0,
          "title": "Max Download Bytes",
          "type": "integer"
        },
        "max_runtime_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Max Runtime Seconds",
          "type": "integer"
        }
      },
      "title": "ExecutionLimits",
      "type": "object"
    },
    "FileRecord": {
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "minLength": 1,
          "title": "File Id",
          "type": "string"
        },
        "investigation_id": {
          "minLength": 1,
          "title": "Investigation Id",
          "type": "string"
        },
        "run_ids": {
          "items": {
            "type": "string"
          },
          "title": "Run Ids",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "role": {
          "enum": [
            "measurement",
            "documentation",
            "video",
            "image",
            "other"
          ],
          "title": "Role",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "retrieval_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Url"
        },
        "source_page_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Page Url"
        },
        "variables": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Variable"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variables"
        },
        "encoding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encoding"
        },
        "data_notes": {
          "items": {
            "type": "string"
          },
          "title": "Data Notes",
          "type": "array"
        },
        "conditions": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Conditions",
          "type": "object"
        },
        "related_file_ids": {
          "items": {
            "type": "string"
          },
          "title": "Related File Ids",
          "type": "array"
        },
        "match_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match Reason"
        }
      },
      "required": [
        "file_id",
        "investigation_id",
        "title",
        "role",
        "media_type"
      ],
      "title": "FileRecord",
      "type": "object"
    },
    "FrontendResponse": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "query_id": {
          "title": "Query Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "needs_input",
            "no_match",
            "error"
          ],
