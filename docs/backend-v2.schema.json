          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/ServiceRequest"
          },
          "title": "Requests",
          "type": "array"
        },
        "blocks": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/CalculationBlock"
              },
              {
                "$ref": "#/$defs/ChartBlock"
              },
              {
                "$ref": "#/$defs/MediaBlock"
              },
              {
                "$ref": "#/$defs/InspectionBlock"
              }
            ]
          },
          "title": "Blocks",
          "type": "array"
        },
        "sources": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Sources",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "errors": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Errors",
          "type": "array"
        },
        "generated_by": {
          "default": "SI-assisted planner; deterministic Python execution",
          "title": "Generated By",
          "type": "string"
        }
      },
      "required": [
        "query_id",
        "status",
        "message"
      ],
      "title": "FrontendResponse",
      "type": "object"
    },
    "InspectionBlock": {
      "additionalProperties": false,
