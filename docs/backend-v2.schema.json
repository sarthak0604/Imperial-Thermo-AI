          "type": "string"
        },
        "x": {
          "$ref": "#/$defs/ChartAxis"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/ChartAxis"
          },
          "title": "Series",
          "type": "array"
        },
        "evidence_type": {
          "enum": [
            "measured",
            "data_reduction",
            "model_estimate"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "illustrative": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Illustrative"
        },
        "source_file_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source File Ids",
          "type": "array"
        }
