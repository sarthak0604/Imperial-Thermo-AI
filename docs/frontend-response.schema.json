{
  "$defs": {
    "CalculationBlock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "calculation",
          "title": "Type",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "data_reduction",
            "model_estimate"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "illustrative": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Illustrative"
        },
        "source_file_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source File Ids",
          "type": "array"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        }
      },
      "required": [
        "type",
        "model_id",
        "evidence_type",
        "illustrative",
        "source_file_ids",
        "data"
      ],
      "title": "CalculationBlock",
      "type": "object"
    },
    "ChartAxis": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "label",
        "unit",
        "values"
      ],
      "title": "ChartAxis",
      "type": "object"
    },
    "ChartBlock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "chart",
          "title": "Type",
          "type": "string"
        },
        "chart_type": {
          "enum": [
            "line",
            "scatter"
          ],
          "title": "Chart Type",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "x": {
          "$ref": "#/$defs/ChartAxis"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/ChartAxis"
          },
          "title": "Series",
          "type": "array"
        },
        "evidence_type": {
          "enum": [
            "measured",
            "data_reduction",
            "model_estimate"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "illustrative": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Illustrative"
        },
        "source_file_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source File Ids",
          "type": "array"
        }
      },
      "required": [
        "type",
        "chart_type",
        "title",
        "x",
        "series",
        "evidence_type",
        "source_file_ids"
      ],
      "title": "ChartBlock",
      "type": "object"
    },
    "ColumnBinding": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "title": "Column",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "column",
        "field",
        "unit"
      ],
      "title": "ColumnBinding",
      "type": "object"
    },
    "DatasetBinding": {
      "additionalProperties": false,
      "description": "Copy measured CSV values into an existing JSON input slot, without conversion.",
      "properties": {
        "target": {
          "pattern": "^/",
          "title": "Target",
          "type": "string"
        },
        "mode": {
          "enum": [
            "scalar",
            "series",
            "records"
          ],
          "title": "Mode",
          "type": "string"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/ColumnBinding"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "row": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Row"
        }
      },
      "required": [
        "target",
        "mode",
        "columns",
        "row"
      ],
      "title": "DatasetBinding",
      "type": "object"
    },
    "ExecutionLimits": {
      "additionalProperties": false,
      "properties": {
        "max_download_bytes": {
          "default": 100000000,
          "exclusiveMinimum": 0,
          "title": "Max Download Bytes",
          "type": "integer"
        },
        "max_runtime_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Max Runtime Seconds",
          "type": "integer"
        }
      },
      "title": "ExecutionLimits",
      "type": "object"
    },
    "InspectionBlock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "inspection",
          "title": "Type",
          "type": "string"
        },
        "file_id": {
          "title": "File Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "table",
            "json",
            "unsupported"
          ],
          "title": "Kind",
          "type": "string"
        },
        "columns": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Columns",
          "type": "array"
        },
        "row_count": {
          "title": "Row Count",
          "type": "integer"
        },
        "preview": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "items": {},
              "type": "array"
            }
          ],
          "title": "Preview"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "note": {
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "type",
        "file_id",
        "kind"
      ],
      "title": "InspectionBlock",
      "type": "object"
    },
    "MediaBlock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "video",
            "document",
            "image"
          ],
          "title": "Type",
          "type": "string"
        },
        "file_id": {
          "title": "File Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "source_page_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Page Url"
        }
      },
      "required": [
        "type",
        "file_id",
        "title",
        "media_type",
        "url",
        "source_page_url"
      ],
      "title": "MediaBlock",
      "type": "object"
    },
    "Plan": {
      "additionalProperties": false,
      "description": "All fields required so this is also an API Structured Outputs schema.",
      "properties": {
        "action": {
          "enum": [
            "inspect_files",
            "calculate",
            "retrieve_assets",
            "no_match"
          ],
          "title": "Action",
          "type": "string"
        },
        "selected_file_ids": {
          "items": {
            "type": "string"
          },
          "title": "Selected File Ids",
          "type": "array"
        },
        "requested_asset_ids": {
          "items": {
            "type": "string"
          },
          "title": "Requested Asset Ids",
          "type": "array"
        },
        "operation": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlotOperation"
            },
            {
              "$ref": "#/$defs/ThermoOperation"
            },
            {
              "type": "null"
            }
          ],
          "title": "Operation"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "action",
        "selected_file_ids",
        "requested_asset_ids",
        "operation",
        "explanation",
        "warnings"
      ],
      "title": "Plan",
      "type": "object"
    },
    "PlotOperation": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "plot_relationship",
          "title": "Name",
          "type": "string"
        },
        "file_id": {
          "title": "File Id",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/PlotParameters"
        }
      },
      "required": [
        "name",
        "file_id",
        "parameters"
      ],
      "title": "PlotOperation",
      "type": "object"
    },
    "PlotParameters": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "string"
        },
        "y": {
          "title": "Y",
          "type": "string"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "PlotParameters",
      "type": "object"
    },
    "ServiceRequest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "query_id": {
          "title": "Query Id",
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/Plan"
        },
        "limits": {
          "$ref": "#/$defs/ExecutionLimits"
        },
        "generated_by": {
          "const": "SI-assisted request planner",
          "default": "SI-assisted request planner",
          "title": "Generated By",
          "type": "string"
        }
      },
      "required": [
        "query_id",
        "plan"
      ],
      "title": "ServiceRequest",
      "type": "object"
    },
    "ThermoOperation": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "run_thermo_model",
          "title": "Name",
          "type": "string"
        },
        "file_id": {
          "title": "File Id",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/ThermoParameters"
        }
      },
      "required": [
        "name",
        "file_id",
        "parameters"
      ],
      "title": "ThermoOperation",
      "type": "object"
    },
    "ThermoParameters": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "enum": [
            "THM-01",
            "THM-02",
            "THM-03",
            "THM-04",
            "THM-05",
            "THM-06",
            "THM-07",
            "THM-08",
            "THM-09",
            "THM-10",
            "THM-11",
            "THM-12",
            "THM-13",
            "THM-14",
            "THM-15",
            "THM-16",
            "THM-17",
            "THM-18",
            "THM-19",
            "THM-20"
          ],
          "title": "Model Id",
          "type": "string"
        },
        "request_json": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Request Json"
        },
        "template_file_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Template File Id"
        },
        "bindings": {
          "items": {
            "$ref": "#/$defs/DatasetBinding"
          },
          "title": "Bindings",
          "type": "array"
        }
      },
      "required": [
        "model_id",
        "request_json",
        "template_file_id",
        "bindings"
      ],
      "title": "ThermoParameters",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "query_id": {
      "title": "Query Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "needs_input",
        "no_match",
        "error"
      ],
      "title": "Status",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "requests": {
      "items": {
        "$ref": "#/$defs/ServiceRequest"
      },
      "title": "Requests",
      "type": "array"
    },
    "blocks": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/CalculationBlock"
          },
          {
            "$ref": "#/$defs/ChartBlock"
          },
          {
            "$ref": "#/$defs/MediaBlock"
          },
          {
            "$ref": "#/$defs/InspectionBlock"
          }
        ]
      },
      "title": "Blocks",
      "type": "array"
    },
    "sources": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Sources",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "errors": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Errors",
      "type": "array"
    },
    "generated_by": {
      "default": "SI-assisted planner; deterministic Python execution",
      "title": "Generated By",
      "type": "string"
    }
  },
  "required": [
    "query_id",
    "status",
    "message"
  ],
  "title": "FrontendResponse",
  "type": "object"
}
