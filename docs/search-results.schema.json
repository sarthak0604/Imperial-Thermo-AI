{
  "$defs": {
    "FileRecord": {
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "minLength": 1,
          "title": "File Id",
          "type": "string"
        },
        "investigation_id": {
          "minLength": 1,
          "title": "Investigation Id",
          "type": "string"
        },
        "run_ids": {
          "items": {
            "type": "string"
          },
          "title": "Run Ids",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "role": {
          "enum": [
            "measurement",
            "documentation",
            "video",
            "image",
            "other"
          ],
          "title": "Role",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "retrieval_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Url"
        },
        "source_page_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Page Url"
        },
        "variables": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Variable"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variables"
        },
        "encoding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encoding"
        },
        "data_notes": {
          "items": {
            "type": "string"
          },
          "title": "Data Notes",
          "type": "array"
        },
        "conditions": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Conditions",
          "type": "object"
        },
        "related_file_ids": {
          "items": {
            "type": "string"
          },
          "title": "Related File Ids",
          "type": "array"
        },
        "match_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match Reason"
        }
      },
      "required": [
        "file_id",
        "investigation_id",
        "title",
        "role",
        "media_type"
      ],
      "title": "FileRecord",
      "type": "object"
    },
    "Variable": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "numeric": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numeric"
        }
      },
      "required": [
        "name"
      ],
      "title": "Variable",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "query_id": {
      "minLength": 1,
      "title": "Query Id",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/FileRecord"
      },
      "title": "Files",
      "type": "array"
    }
  },
  "required": [
    "query_id",
    "files"
  ],
  "title": "SearchResults",
  "type": "object"
}
