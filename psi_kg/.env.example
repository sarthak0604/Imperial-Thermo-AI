# Default matches the test branch's local instruction model. No API key needed.
LLM_PROVIDER=local
LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
LLM_DEVICE=auto
LLM_CONTEXT_TOKENS=262144
# Working input budget includes instructions, JSON schema and all source metadata.
LLM_INPUT_TOKENS=8192
LLM_MAX_NEW_TOKENS=8192
LLM_MIN_REQUEST_INTERVAL_SECONDS=0
# Set to 1 after downloading if you require cached model files only.
LLM_LOCAL_FILES_ONLY=0
# Install/run: uv run --extra local psi-graph-manage
# Other providers remain available: gemini, openai, anthropic, openai-compatible.
# This template is committed. Keep credentials blank here.
# Put your key in ~/.config/imperial-thermo-ai/.env instead.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Compatible endpoints only:
LLM_BASE_URL=
LLM_API_KEY=
# Supply the investigation URL as the positional argument to uv run psi-graph.
# Use --env-file /path/to/.env to load this configuration.
# API providers require credentials; local Qwen does not.

# Guided Gemini setup (hidden key entry, available models, API test):
# uv run psi-setup-gemini
# Interactive create/update with a new NASA PSI URL:
# uv run psi-graph-manage
