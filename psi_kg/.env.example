# Choose gemini, openai, anthropic, or openai-compatible.
LLM_PROVIDER=gemini
# Required: a structured-output model available to your provider/account.
LLM_MODEL=
# Fill the credential corresponding to your provider.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Compatible endpoints only:
LLM_BASE_URL=
LLM_API_KEY=
# Supply the investigation URL as the positional argument to uv run psi-graph.
# Use --env-file /path/to/.env to load this configuration.
# Without credentials, --stage prepare downloads and parses only.

# Guided Gemini setup (hidden key entry, available models, API test):
# uv run psi-setup-gemini
# Interactive create/update with a new NASA PSI URL:
# uv run psi-graph-manage
