            "properties": {
              "title": "Pressure-dependent extinction and warm-flame transitions of n-dodecane droplets",
              "summary": "Numerical predictions and measured hot/cool extinction diameters are compared for n-dodecane droplets in air over varying pressure. The presentation reports nonlinear pressure dependence, hot–cool cycling near 1.25 atm and a stable warm-flame regime at 3 atm. The 4 mm extinction sweep is distinct from the 7 mm multicycle example.",
              "keywords": [
                "pressure",
                "extinction",
                "warm flame",
                "n-dodecane",
                "hot-cool cycling",
                "NTC"
              ],
