              ],
              "explanation": "Query matches the concept; a source-supported STUDIES edge connects it to this experiment.",
              "evidence": [
                {
                  "source_url": "https://psi.nasa.gov/geode-py/ws/studies/PSI-117/download?file=6a282739d9d7246402cb43e0&version=1&studyVersion=2&redirect=true",
                  "locator": "page 13",
                  "text": "13 Multicycle Behavior Evolution of Kb and Tmax for n-dodecane droplet combustion at 1.25 atm (do = 7.00 mm, air) • Four “Hot-Cool” flame transition. • At every transition, the cool flame temperature decreases significantly, the burn time increases. • The hot flame behavior remains unaltered."
                }
              ]
            },
            {
              "concept": "Pressure-dependent flame extinction",
              "matched_terms": [
                "cool",
                "flame"
              ],
              "explanation": "Query matches the concept; a source-supported STUDIES edge connects it to this experiment.",
              "evidence": [
                {
                  "source_url": "https://psi.nasa.gov/geode-py/ws/studies/PSI-117/download?file=6a282739d9d7246402cb43e0&version=1&studyVersion=2&redirect=true",
                  "locator": "page 15",
                  "text": "15 Extinction Diameter: Pressure Dependence Comparison of predicted and measured de,HF and de,CF as a function of operating pressure for of n-dodecane droplets burning in air. (do = 4.00 mm). • Both hot and cool flame extinction diameter has a non-linear dependence on pressure. • de,CF decreases as pressure is increased, and is absent at 3 atm as the droplet burns to completion following a “Warm” flame combustion • The de,CF is most sensitive to: •O2QnOOH → •OQn`OOH + OH •O2QnOOH → QnOOH + O2"
                }
              ]
            }
