            "type": "Experiment",
            "properties": {
              "title": "Initial diameter and alkane chain-length effects on cool-flame extinction",
              "summary": "Transient droplet-combustion calculations for n-heptane, n-decane and n-dodecane are compared with experimental extinction data in atmospheric air. The source reports stronger cool-flame reactivity and smaller cool-flame extinction diameters for longer n-alkanes, while hot-flame extinction characteristics are similar.",
              "keywords": [
                "extinction",
                "n-alkane",
                "chain length",
                "initial diameter",
                "cool flame"
              ],
              "conditions": {
